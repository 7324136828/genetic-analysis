# GenomeScope configuration (copy to .env; .env is git-ignored). All values are optional.
# Never put real credentials in this file.

# --- NCBI E-utilities --------------------------------------------------------
# API key raises the NCBI rate limit from 3 to 10 requests/s (https://www.ncbi.nlm.nih.gov/account/settings/)
NCBI_API_KEY=
# Contact e-mail NCBI asks E-utilities clients to send (optional)
NCBI_EMAIL=
# Persistent NCBI response cache TTL in hours (per analysis)
NCBI_CACHE_TTL_HOURS=168

# --- Privacy -----------------------------------------------------------------
# 1 = never contact MyVariant.info, mygene.info, NCBI or the ClinVar FTP
GENOMESCOPE_OFFLINE=0

# --- Jobs / temp folder ------------------------------------------------------
# Where analyses run (default: <system temp>/genomescope_jobs)
GENOMESCOPE_JOBS_DIR=
# Finished analyses older than this are purged automatically (0 = keep until deleted)
GENOMESCOPE_JOB_TTL_HOURS=168
# Maximum total upload size per analysis, in MB
GENOMESCOPE_MAX_UPLOAD_MB=4096
# Analyses processed at the same time (others wait in the queue)
GENOMESCOPE_MAX_CONCURRENT_JOBS=1

# --- Shared ClinVar release cache (public reference data, ~1.2 GB) -----------
# Default: %LOCALAPPDATA%/genomescope/clinvar (Windows) or ~/.cache/genomescope/clinvar
GENOMESCOPE_CLINVAR_DIR=

# --- Network exposure (the defaults keep the API local-only) ------------------
# Comma-separated allowed CORS origins (run.bat / run.sh set this automatically)
GENOMESCOPE_CORS_ORIGINS=
# Comma-separated Host-header allow-list ("*" = any; blocks DNS rebinding by default)
GENOMESCOPE_ALLOWED_HOSTS=
